# 复制这个文件为 .env（真实的.env不会被git追踪），填好之后再 docker compose up -d
# 参考: https://docs.karakeep.app/configuration

DATA_DIR=/data
NEXTAUTH_URL=http://localhost:3000

# 下面两个密钥用命令生成，不要手写:
#   openssl rand -base64 36                          -> NEXTAUTH_SECRET
#   openssl rand -base64 36 | tr -dc 'A-Za-z0-9'      -> MEILI_MASTER_KEY (必须是纯字母数字)
NEXTAUTH_SECRET=
MEILI_MASTER_KEY=

# ---- 可选：接LLM做自动摘要/打标签（用于"行业人物言论采集"→自动提炼）----
# 方式一：接 Claude/OpenAI 兼容端点
# OPENAI_API_KEY=sk-xxxx
# INFERENCE_TEXT_MODEL=gpt-4.1-mini
# INFERENCE_ENABLE_AUTO_SUMMARIZATION=true

# 方式二：接本地 Ollama（走OpenAI兼容层）
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# INFERENCE_TEXT_MODEL=gemma3
# INFERENCE_ENABLE_AUTO_SUMMARIZATION=true

# ---- 固定版本号（生产环境建议锁定，别用浮动的 release）----
# KARAKEEP_VERSION=0.33.2
